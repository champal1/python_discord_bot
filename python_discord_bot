import discord
import os
import requests
import json
import random
from replit import db
from keep_alive import keep_alive

client = discord.Client()

# when someone types sad words in chat
sad_words = ["sad", "depressed", "unhappy", "angry", "miserable", "depressing"] 

# user able to add more encouragements
starter_encouragements = [
  "Cheer up! "
  "Hang in there. "
  "You are a great person! "
  "I believe in you "
]

if "responding" not in db.keys():
  db["responding"] = True

# fuction to return api quotes
def get_quote():
  response = requests.get("https://zenquotes.io/api/random")
  json_data = json.loads(response.text)
  quote = json_data[0]["q"] + " -" + json_data[0]["a"]
  return(quote)

# update/ add encouragement from user
def update_encouragements(encouraging_message):
  if "encouragements" in db.keys():
    encouragements = db["encouragements"]
    encouragements.append(encouraging_message)
    db["encouragements"] =encouragements
  else:
    db["encouragements"] = [encouraging_message]

# delete encouragement message
def delete_encouragement(index):
  encouragements = db["encouragements"]
  if len(encouragements) > index:
    del encouragements[index]
    db["encouragements"] = encouragements

@client.event
# getting bot ready
async def on_ready():
  print("We have log in as {0.user}".format(client))

# if it gets a message
@client.event
async def on_message(message):
  if message.author == client.user:
    return

  msg = message.content
  
# message is sent w/ command send to our bot, if someone send $hello, the bot will say hello
  if msg.startswith("$inspire"):
    quote = get_quote()
    await message.channel.send(quote)
  
  if db["responding"]:
    #update/delete from discord
    options = starter_encouragements
    if "encouragements" in db.keys():
      options = options + list(db["encouragements"])
  
    # if one of the sad words is used 
    if any(word in msg for word in sad_words):
      await message.channel.send(random.choice(options))

  if msg.startswith("$new"):
    encouraging_message = msg.split("$new ", 1)[1]
    update_encouragements(encouraging_message)
    await message.channel.send("New encouraging message added.")

  # user to delete message 
  if msg.startswith("$del"):
    encouragements = []
    if "encouragements" in db.keys():
      index = int(msg.split("$del",1)[1])
      delete_encouragement(index)
      encouragements = db["encouragements"]
    await message.channel.send(encouragements)
  #see list of encouragements
  if msg.startswith("$list"):
    encouragements = []
    if "encouragements" in db.keys():
      encouragements = db["encouragements"]
      await message.channel.send(encouragements)

  if msg.startswith("$responding"):
    value = msg.split("$responding ", 1)[1]

    if value.lower() == "true":
      db["responding"] = True
      await message.channel.send("Responding is on.")
    else:
      db["responding"] = False
      await message.channel.send("Responding is off.")

keep_alive()
# run the bot
client.run(os.getenv("discord_bot"))

